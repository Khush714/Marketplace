{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
"profile": "node scripts/profiling/measure.mjs",
    "db:push": "drizzle-kit push",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:status": "node scripts/db-migrate.mjs --status",
    "verify": "npm run typecheck && npm run lint && npm test",
    "db:reset": "tsx src/db/reset.ts --confirm",
    "db:seed": "tsx src/db/seed.ts --confirm",
    "test": "tsx --test tests/*.test.ts tests/security/*.test.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:security": "tsx --test tests/security/*.test.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.6",
    "pg": "8.20.0",
    "razorpay": "^2.9.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
