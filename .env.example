# Copy to .env and fill in real values. NEVER commit .env.
# DATABASE_URL is loaded by src/db/index.ts (app runtime).
# MIGRATIONS_DATABASE_URL is preferred by the schema tools (drizzle.config.ts
# and scripts/db-migrate.mjs) and falls back to DATABASE_URL when unset.

# Postgres (Supabase) — use the pooler connection string with sslmode=require.
#
# Phase 10 (database security): DATABASE_URL should be the RESTRICTED
# `marketplace_app` role created by
# src/db/migrations/20261007_application_role.sql — SELECT/INSERT/UPDATE/DELETE
# on the application tables only: no DDL, no role management, no TRUNCATE, no
# access to the schema_migrations ledger. Apply that migration as the owner,
# give the role a password out-of-band (the committed migration never contains
# one), then switch DATABASE_URL to it:
#   ALTER ROLE marketplace_app PASSWORD '<random>';
# MIGRATIONS_DATABASE_URL keeps the owner/admin credential for schema changes
# (npm run db:migrate, npm run db:push) — the app role deliberately cannot
# run those. In a single-role dev setup leave MIGRATIONS_DATABASE_URL unset
# and both tools fall back to DATABASE_URL.
DATABASE_URL=postgresql://marketplace_app:password@host:6543/postgres?sslmode=require
MIGRATIONS_DATABASE_URL=postgresql://postgres:password@host:6543/postgres?sslmode=require

# Restaurant AI POS — base URL the Marketplace backend uses to POST orders,
# payments and cancellations, and to verify + claim POS connection codes
# (Restaurant Connection & Identity Bridge).
#
# THIS MUST BE THE RECIPROCAL of MARKETPLACE_BASE_URL in the POS repo's
# Backend/.env — not .env.local. The POS reads that variable to call us back at
# GET /health and POST /api/integrations/webhooks/*. If the two disagree the
# integration silently runs one-way: we push orders the POS never sees as
# connected, or the POS pushes statuses we never receive.
#
# Both default to localhost, which only resolves while BOTH run on this host.
# A deployed marketplace pointing at localhost is a dead integration — and that
# is now enforced, not just documented: src/lib/pos-bridge.ts refuses to issue a
# bridge call when this resolves to loopback and VERCEL_ENV=production.
#
# Do NOT point this at a `*.trycloudflare.com` quick tunnel. Those subdomains
# die with the local `cloudflared` process and change on every restart, so the
# URL looks configured right up until it stops resolving and every bridge call
# 502s. The deployed POS backend serves /health and the inbound connection
# bridge under its /api prefix, e.g. https://<pos-host>/api — verify with:
#   curl https://<pos-host>/api/health          -> {"status":"ok",...}
#   curl https://<pos-host>/api/health/live     -> {"status":"ok",...}
# Reachability can also be checked from the ops console (/ops -> POS bridge) or
# GET /api/ops/pos-bridge, which reports the host and the classified cause.
POS_BASE_URL=http://localhost:5000

# Feature flags
# Require a live POS connection before admitting checkout. IMPORTANT: this
# parser (src/lib/ordering-gate.ts) honours ONLY the literal strings "true" and
# "false" — "1"/"0"/"yes" fall through to the NODE_ENV default, which disables
# the gate in dev while looking configured. There is no boolean coercion.
MARKETPLACE_ORDERING_ENABLED=true
TABLZ_EXPOSE_DEV_OTP=true

# Display
CURRENCY=INR
CURRENCY_LOCALE=en-IN

# Razorpay payments (test keys for dev)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Menu webhook envelope key — seals POS webhook secrets at rest (AES-256-GCM).
# High-entropy (≥32 bytes, hex preferred). Falls back to RAZORPAY_WEBHOOK_SECRET.
INTEGRATION_ENVELOPE_KEY=

# Order access tokens (Phase 7) — HMAC key behind the per-order token a customer
# browser is issued at checkout. Reading, cancelling or paying for an order
# requires it, so losing/rotating it makes existing order links unreadable.
# High-entropy (≥32 bytes). Falls back to INTEGRATION_ENVELOPE_KEY; in production
# a missing value fails closed rather than issuing guessable tokens.
ORDER_TOKEN_SECRET=

# POS order delivery (Phase 4) — durable journal that pushes checkout orders to
# the POS bridge and retries until DELIVERED/FAILED.
#
# WHERE THE DRAIN RUNS DEPENDS ON THE HOST:
#   * Long-lived Node server (docker, VPS, bare metal): the in-process loop in
#     src/instrumentation.ts sweeps every POS_DELIVERY_DRAIN_INTERVAL_MS.
#   * Vercel / any serverless host: functions are ephemeral and scale to zero,
#     so the loop is skipped automatically and the scheduled endpoints in
#     vercel.json do the work instead —
#       GET/POST /api/cron/pos-drain        03:00 UTC daily   (orders -> POS)
#       GET/POST /api/cron/payments-drain   03:30 UTC daily   (payments -> POS + reconcile)
#     Both are idempotent, so an overlapping or retried scheduler fire is safe.
#
#     These are DAILY, and that is a Vercel Hobby constraint, not a preference:
#     Hobby only accepts a daily cron expression, so sub-daily schedules are
#     rejected outright at deploy time. Sub-minute draining is what the
#     in-process loop above is for — on Hobby the queue is drained once a day,
#     so a delay between order placement and POS delivery is expected rather
#     than a bug. If that latency is unacceptable, drive the same endpoints from
#     an external scheduler (GitHub Actions / QStash) with CRON_SECRET; the
#     routes are idempotent and will accept that happily.
# POS_DELIVERY_DRAIN_ENABLED=true         # set "false" to disable the in-process loop
# POS_DELIVERY_DRAIN_INTERVAL_MS=15000    # worker sweep cadence (ms)
# REQUIRED IN PRODUCTION. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POS_DELIVERY_OPS_TOKEN=

# Scheduled-drain authentication. The cron endpoints accept EITHER this bearer
# token or POS_DELIVERY_OPS_TOKEN (sent as `Authorization: Bearer <CRON_SECRET>`
# or `x-ops-token` respectively). Set at least one, or the cron routes answer
# 503 and orders never reach the POS.
#   - On Vercel, the platform's own scheduler is trusted automatically.
#   - Anywhere else, or for GitHub Actions / QStash / an external scheduler,
#     set CRON_SECRET and send `Authorization: Bearer <CRON_SECRET>`.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Ops console (WS-8). The token above authenticates every privileged operator
# route; send it as the `x-ops-token` header. Unset leaves them OPEN in
# development and CLOSED in production (503) — so set it in any deployed
# environment. Console: /ops
#   GET|POST /api/partner/codes            mint + enumerate onboarding codes
#   GET      /api/partner/codes/[code]     inspect one code
#   GET      /api/partner/connect          list live POS connections
#   GET      /api/ops/pos-bridge           is the configured POS reachable?
#   POST     /api/integrations/pos/drain   force a delivery-drain pass
#   POST     /api/integrations/payments/ops  force payment drain + reconcile
# `POST /api/partner/connect` is deliberately NOT token-gated: redeeming a
# single-use code is the restaurant's own onboarding handshake.

# Deployment health. /api/health is the readiness probe: it verifies the DB
# round-trips and reports whether the POS bridge is configured/reachable.
# Never returns secrets — only booleans, hosts and classified failure reasons.

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=